{
  "description": "mastermem: memory push on session start, prompt, tool batch and shell command, team rules on every tool call, lesson nudge and turn end rules on Stop, turn end rules of subagents on SubagentStop. Exec form (no shell) of the bundled mastermem-hook helper: it reads server and token from its environment (never from args), posts stdin to <server>/v1/hook/<event>, fails open (exit 0, no output) on any error.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "session-start",
              "3"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "user-prompt-submit",
              "2"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "post-tool-batch",
              "2"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "pre-tool-use",
              "1"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "stop",
              "1"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/mastermem-hook",
            "args": [
              "subagent-stop",
              "1"
            ],
            "timeout": 2
          }
        ]
      }
    ]
  }
}
